{
  "manifest_version": 3,
  "name": "YouTube Super Lite",
  "version": "0.0.0",
  "description": "公式 YouTube の watch ページから無駄を剥ぎ、視聴に必要な部分だけを残す。",
  "permissions": ["storage", "declarativeNetRequest"],
  "background": {
    "service_worker": "sw.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/watch*",
        "https://www.youtube.com/live_chat*"
      ],
      "js": ["main.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.youtube.com/watch*",
        "https://www.youtube.com/live_chat*"
      ],
      "js": ["isolated.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "ISOLATED"
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      { "id": "a-telemetry", "enabled": true, "path": "rules/a-telemetry.json" },
      {
        "id": "a-ads-tracking",
        "enabled": true,
        "path": "rules/a-ads-tracking.json"
      },
      {
        "id": "a-thumbnails",
        "enabled": false,
        "path": "rules/a-thumbnails.json"
      },
      {
        "id": "exp-heartbeat",
        "enabled": false,
        "path": "rules/experiments/exp-heartbeat.json"
      },
      {
        "id": "exp-attestation",
        "enabled": false,
        "path": "rules/experiments/exp-attestation.json"
      },
      {
        "id": "exp-prefetch",
        "enabled": false,
        "path": "rules/experiments/exp-prefetch.json"
      }
    ]
  }
}
